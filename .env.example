# AnnRakshak — copy to .env (gitignored) and fill in. Only SARVAM_API_KEY is
# needed for the full demo (OPENWEATHER_API_KEY is recommended); everything else has a working keyless default.
# See docs/INTEGRATIONS.md for what each one unlocks.

# --- Required for voice (Sarvam AI: Bulbul TTS, Saaras STT, Sarvam-Translate)
SARVAM_API_KEY=
# Optional: more keys, comma-separated — rotated; one out of credits is benched and the next used
SARVAM_API_KEYS=

# --- Optional: weather right now during the live field check (OpenWeather
#     "Current weather" API). Without it the keyless Open-Meteo current
#     conditions are used.
OPENWEATHER_API_KEY=

# --- Optional: satellite crop greenness (NDVI) and soil per field — AgroMonitoring
AGRO_API_KEY=

# --- Optional: Kisan Call Centre pull (data/kcc_pull.py) — data.gov.in → My Account → API key
DATA_GOV_IN_API_KEY=

# --- Optional: email alerts and the 6 am farm summary (any SMTP relay; Gmail needs an app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl | none
# SMTP_USER=you@example.com
# SMTP_PASSWORD=
# EMAIL_FROM="AnnRakshak <you@example.com>"
# Without SMTP_HOST, emails are written to DATA_DIR/outbox as .eml files.

# --- Optional: phone notifications (Web Push). Generated into DATA_DIR on first use if unset.
# VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# VAPID_SUBJECT=mailto:alerts@example.org
# ANNRAKSHAK_PUBLIC_URL=https://app.example.org   # links in emails and notifications

# --- Optional: Redis (Upstash or any) — shared cache, rate limits, one watcher, events across instances
# REDIS_URL=rediss://default:<token>@<host>:6379

# --- Optional: background watcher (weather rules, alerts, pushes, emails). Run exactly one per deployment.
# ANNRAKSHAK_WATCH=on

# --- Optional: storage (defaults to backend/.data/ with SQLite)
# ANNRAKSHAK_DATA_DIR=/var/lib/annrakshak
# Postgres (Supabase / Neon): use the pooled URL for the app; postgres:// is accepted
# ANNRAKSHAK_DB_URL=postgresql+psycopg://user:pass@host:6543/postgres?sslmode=require

# --- Optional: force the labelled stub model (tests do this; leave unset to use ml/artifacts/)
# ANNRAKSHAK_VISION=stub

# --- Sign-in (roles, one-time codes, sessions)
# Codes are emailed (see SMTP above); both roles give a mobile number at sign-up
# and SMS is a later swap. Production MUST set ANNRAKSHAK_COOKIE_SECURE=on
# (HTTPS-only session cookie) and turn the demo sign-in and auto-verification off.
# ANNRAKSHAK_AUTH=on                     # off only for the older flow tests
# ANNRAKSHAK_COOKIE_SECURE=on            # on behind HTTPS; off for localhost
# ANNRAKSHAK_DEMO_LOGIN=off              # 'Try the demo' buttons on the login screen
# ANNRAKSHAK_EXPERT_AUTO_VERIFY=off      # off: the district office verifies new experts

# --- Not wired yet: the next integrations (see docs/INTEGRATIONS.md)
# --- Optional: production weather (Open-Meteo is keyless but rate-limited per IP)
# OPEN_METEO_API_KEY=

# --- Optional: SMS / IVR alerts for farmers without smartphones
# SMS_PROVIDER=msg91            # msg91 | exotel | twilio
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_DLT_TEMPLATE_ID=          # TRAI DLT registration is mandatory for SMS in India

# --- Optional: production map tiles (OSM's public tiles are for light use only)
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/landscape/{z}/{x}/{y}.png?key=YOUR_KEY

# --- Frontend dev proxy target (Vite)
# ANNRAKSHAK_API=http://127.0.0.1:8010
